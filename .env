# ⚠️  Bu dosyayı asla git'e commit etme!
# Doldurma rehberi için .env.example dosyasına bak.

NODE_ENV=development
PORT=5000

# Supabase bağlantısını buraya yaz (şifreyi DEĞİŞTİRDİKTEN sonra)
DATABASE_URL=

# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

PUBLIC_URL=http://localhost:5000
ADMIN_USERS=admin

# Prod'da domain kısıtla: ALLOWED_ORIGINS=https://yourdomain.com
ALLOWED_ORIGINS=*

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@understate.game

# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

GIPHY_API_KEY=

# AWS S3 (opsiyonel)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=

MONGODB_URI=
