# ================================================
# UNDERSTATE — Environment Variables Template
# Kopyala: cp .env.example .env
# ================================================

# --- Sunucu ---
NODE_ENV=development
PORT=5000

# --- MongoDB Atlas ---
# Format: mongodb+srv://<user>:<şifre>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# --- JWT ---
# Üretmek için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- Domain (production'da dolu olmalı) ---
# Render otomatik set eder: RENDER_EXTERNAL_URL
PUBLIC_URL=
# Örnek: PUBLIC_URL=https://understate.onrender.com

# --- Ekstra CORS (virgülle ayır) ---
# EXTRA_ORIGINS=https://myapp.com,https://www.myapp.com

# --- Admin (virgülle ayır) ---
ADMIN_USERS=admin

# --- SMTP (şifre sıfırlama emaili için) ---
# Gmail örneği: SMTP_HOST=smtp.gmail.com, PORT=587
# Uygulama şifresi: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@understate.game
