# Sunucu
NODE_ENV=development
PORT=5000

# MongoDB Atlas
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_string

# Supabase (opsiyonel)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
