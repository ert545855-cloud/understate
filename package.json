    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "nodemailer": "^8.0.7",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0"
  }
}
